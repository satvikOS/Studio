# gitignore template for LangChain products, e.g., LangGraph, LangSmith
# website: https://www.langchain.com/
# website: https://www.langchain.com/langgraph

# LangGraph
.langgraph_api/

# Dependencies
node_modules/
package-lock.json

# Cache directory (but keep creditUsage.json)
backend/db/cache/

# Test scripts
test-*.js

# Environment variables
.env
.env.local
.env.production

# Local LLM credentials — NEVER commit
.llm-credentials.local.json

# Build output
/dist/
frontend/dist/
/build/
.vite/

# Slice 345 — removed from the repo for space (was 484 MB combined):
#   blender/             — vendored Blender source (reference-only, public)
#   foundation-output/   — stale Mech foundational-testing artefacts
#   archive/             — old e2e specs + engine output
# Re-ignore so they can't be re-committed accidentally.
/blender/
/foundation-output/
/archive/

# Playwright / e2e local artefacts — never need to ship
/test-results/
/e2e/screenshots/
/playwright-report/

# IDE
.vscode/
.idea/
*.swp
*.swo

# OS
.DS_Store
Thumbs.db

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
*.backup
.serverless/
lambda-deployment.zip
*.zip
.serverless/
lambda-*.zip
test-results/
dist-electron/
ge9x-deliverable/
autonomous-output/
engine-output/

# E2E artefacts (regenerated on every run; never commit)
e2e-output/
e2e/screenshots/

# Large local reference media — never commit (course videos in repo root)
*.mp4
*.webm
*.mov

# Video sampling artefacts (one-shot thumbnails extracted for scope review)
tools/.video-thumbs/

# AI-orchestration scratch / wakeup notes
docs/superpowers/notes/custom-occt-build-recon.md
.claude/worktrees/
image.png
e2e/demo/shots/studio/anim_frames/
